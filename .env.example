APP_URL=https://cms.shyfted.com.au
DATABASE_URL=sqlite:///data/cms.db
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
SHYFTED_STORAGE_DIR=/app/storage

# Sessions
SESSION_LIFETIME_HOURS=8
SESSION_COOKIE_SECURE=true

# Password resets and request throttling
RESET_TOKEN_MINUTES=30
LOGIN_RATE_LIMIT=5
RESET_RATE_LIMIT=5
RATE_LIMIT_WINDOW_MINUTES=15

# Email delivery for password reset links
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM="Shyfted CMS <cms@shyfted.com.au>"
SMTP_USE_TLS=true

# ESL delivery (keep the secret in the deployment secret manager)
HANSHOW_BASE_URL=https://ausnz-tst-allstar.hanshowcloud.net
HANSHOW_CLIENT_ID=guest
HANSHOW_CLIENT_SECRET=replace-with-provider-secret
HANSHOW_CUSTOMER_CODE=ausnz
HANSHOW_STORE_CODE=017
HANSHOW_TIMEOUT_SECONDS=30
# Provider bindings stay server-side. Supported profiles are 1600x1200 Lumina and 672x960 Nebular Pro.
SHYFT_ESL_TARGETS='[{"id":"lumina-a","label":"Lumina A","sku":"existing-bound-sku-a","width":1600,"height":1200,"rotation":0,"render_profile":"six_colour_eink"},{"id":"nebular-a","label":"Nebular Pro A","sku":"existing-bound-sku-nebular-a","width":672,"height":960,"rotation":0,"render_profile":"six_colour_eink"}]'
# Optional allow-list controlling which configured displays appear in the ESL workspace.
SHYFT_ESL_UI_TARGET_IDS=lumina-a,nebular-a
