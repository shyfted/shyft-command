APP_URL=https://cms.shyfted.com.au
DATABASE_URL=sqlite:///data/cms.db
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
SHYFTED_STORAGE_DIR=/app/storage

# Sessions
SESSION_LIFETIME_HOURS=8
SESSION_COOKIE_SECURE=true

# Password resets and request throttling
RESET_TOKEN_MINUTES=30
LOGIN_RATE_LIMIT=5
RESET_RATE_LIMIT=5
RATE_LIMIT_WINDOW_MINUTES=15

# Email delivery for password reset links
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM="Shyfted CMS <cms@shyfted.com.au>"
SMTP_USE_TLS=true

# ESL delivery (keep the secret in the deployment secret manager)
HANSHOW_BASE_URL=https://ausnz-tst-allstar.hanshowcloud.net
HANSHOW_CLIENT_ID=guest
HANSHOW_CLIENT_SECRET=replace-with-provider-secret
HANSHOW_CUSTOMER_CODE=ausnz
HANSHOW_STORE_CODE=017
HANSHOW_TIMEOUT_SECONDS=30
# Provider bindings stay server-side. ESL Updates v1 exposes at most two 1600x1200 targets.
SHYFT_ESL_TARGETS='[{"id":"lumina-a","label":"Lumina A","sku":"existing-bound-sku-a","width":1600,"height":1200,"rotation":0,"render_profile":"lumina_six_colour"},{"id":"lumina-b","label":"Lumina B","sku":"existing-bound-sku-b","width":1600,"height":1200,"rotation":0,"render_profile":"lumina_six_colour"}]'
# Optional allow-list when SHYFT_ESL_TARGETS contains additional 1600x1200 devices.
SHYFT_ESL_UI_TARGET_IDS=lumina-a,lumina-b
